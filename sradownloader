import sys
import subprocess
import os
import csv
import argparse
import glob
import urllib.request
import re
import time
import threading
import select
from ftplib import FTP


VERSION = "3.11-mod"

# Symbols to remove from proposed file names
invalid_characters = [
    " ", "/", ">", "<", "|", "\"", "?", "*",
    "(", ")", "\\", "[", "]", "{", "}", "!", "&", "#",
]


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def _format_bytes(n):
    """Return a human-readable byte-size string."""
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TB"


# ---------------------------------------------------------------------------
# ENA download
# ---------------------------------------------------------------------------

def download_sample_ena(sample, options):
    if not options.quiet:
        print(f"[ENA] Downloading {sample['accession']} into {sample['file_base']}", flush=True)

    ena_rest_url = (
        "https://www.ebi.ac.uk/ena/portal/api/filereport"
        f"?accession={sample['accession']}&result=read_run&fields=run_accession,fastq_ftp"
    )

    try:
        with urllib.request.urlopen(ena_rest_url, timeout=30) as response:
            if response.getcode() != 200:
                raise IOError(
                    f"[ENA] Got error code {response.getcode()} from ENA REST "
                    f"for accession {sample['accession']}"
                )

            url_list = []
            found_accession_line = False

            for line in response:
                line = line.decode("UTF-8").strip()
                if line.startswith("SRR") or line.startswith("ERR"):
                    found_accession_line = True
                    sections = line.split("\t")
                    if len(sections) != 2:
                        raise IOError(
                            f"[ENA] No ENA fastq files found for accession {sample['accession']}"
                        )
                    url_list = sections[1].split(";")
                    break

            if not found_accession_line:
                raise IOError(
                    f"[ENA] Found no accession in ENA REST response "
                    f"for accession {sample['accession']}"
                )

    except IOError:
        raise
    except Exception as ex:
        raise IOError(f"[ENA] Failed to query ENA REST API: {ex}")

    for url in url_list:
        url_sections = url.split("/")
        server = url_sections[0]
        file   = url_sections[-1]
        folder = "/".join(url_sections[1:-1])

        outfile = (
            sample["file_base"] + "_2.fastq.gz"
            if url.endswith("_2.fastq.gz")
            else sample["file_base"] + "_1.fastq.gz"
        )
        if options.outdir != ".":
            outfile = f"{options.outdir}/{outfile}"

        if os.path.exists(outfile) and os.path.getsize(outfile) > 0:
            if not options.force:
                if not options.quiet:
                    print(
                        f"Skipping {url} as outfile {outfile} exists "
                        "(override with --force)",
                        flush=True,
                    )
                continue

        for attempt_number in range(1, options.retries + 1):
            if not options.quiet:
                print(
                    f"[ENA Attempt {attempt_number}] Downloading {url} into {outfile}",
                    flush=True,
                )

            if attempt_number > 1:
                sleep_time = min(attempt_number ** 2, 30)
                print(f"Sleeping {sleep_time}s before retrying …")
                time.sleep(sleep_time)

            try:
                if options.axel:
                    _download_with_axel(server, folder, file, outfile, options)
                else:
                    _download_with_ftp(server, folder, file, outfile, options)
                break  # success

            except Exception as ex:
                # Remove any partial file so the next attempt starts clean
                if os.path.exists(outfile):
                    try:
                        os.unlink(outfile)
                    except OSError:
                        pass

                if attempt_number == options.retries:
                    raise IOError(
                        f"[ENA] Download repeatedly failed for {sample['accession']} "
                        f"— giving up: {ex}"
                    )
                print(
                    f"[ENA] Attempt {attempt_number} failed for {sample['accession']}: "
                    f"{ex} — retrying",
                    flush=True,
                )


def _download_with_axel(server, folder, file, outfile, options):
    """Download via axel (multi-connection, native progress display)."""
    ftp_url = f"ftp://{server}/{folder}/{file}"
    cmd = ["axel", "-n", str(options.axel_threads), "-o", outfile, ftp_url]

    if not options.quiet:
        print(f"[axel] {ftp_url}", flush=True)

    result = subprocess.run(cmd, check=False)

    if result.returncode != 0:
        raise IOError(f"axel exited with code {result.returncode}")

    if os.path.exists(outfile) and os.stat(outfile).st_size == 0:
        os.unlink(outfile)
        raise IOError("axel produced a zero-sized file")


def _download_with_ftp(server, folder, file, outfile, options):
    """Download via FTP with live speed + percentage progress bar."""
    ftp = FTP(server, timeout=60)
    ftp.login()
    ftp.cwd(folder)

    # Try to get the remote file size for a percentage display
    try:
        ftp.voidcmd("TYPE I")
        total_size = ftp.size(file)
    except Exception:
        total_size = None

    bytes_downloaded = [0]
    thread_exception  = [None]
    interval_bytes    = [0]
    interval_start    = [time.monotonic()]

    with open(outfile, "wb") as ftp_out:
        sock = ftp.transfercmd("RETR " + file)
        sock.setblocking(0)

        def _background():
            try:
                while True:
                    ready = select.select([sock], [], [], 30)
                    if ready[0]:
                        block = sock.recv(1024 * 1024)
                        if not block:
                            break
                        ftp_out.write(block)
                        n = len(block)
                        bytes_downloaded[0] += n
                        interval_bytes[0]   += n
                    else:
                        raise IOError("No data received before 30 s timeout")
                sock.close()
            except Exception as e:
                thread_exception[0] = e

        t = threading.Thread(target=_background, daemon=True)
        t.start()
        label = os.path.basename(outfile)

        while t.is_alive():
            t.join(1)

            if thread_exception[0] is not None:
                raise thread_exception[0]

            if not options.quiet:
                now     = time.monotonic()
                elapsed = now - interval_start[0]
                if elapsed >= 1.0:
                    speed            = interval_bytes[0] / elapsed
                    interval_bytes[0]  = 0
                    interval_start[0]  = now
                    downloaded       = bytes_downloaded[0]
                    speed_str        = _format_bytes(speed) + "/s"

                    if total_size:
                        pct      = downloaded / total_size * 100
                        bar_len  = 25
                        filled   = int(bar_len * downloaded / total_size)
                        bar      = "█" * filled + "░" * (bar_len - filled)
                        line     = (
                            f"\r[ENA] {label}  [{bar}] {pct:5.1f}%  "
                            f"{_format_bytes(downloaded)} / {_format_bytes(total_size)}  "
                            f"{speed_str}   "
                        )
                    else:
                        line = (
                            f"\r[ENA] {label}  {_format_bytes(downloaded)} downloaded  "
                            f"{speed_str}   "
                        )
                    print(line, end="", flush=True)

            # Keep FTP control channel alive
            try:
                ftp.voidcmd("NOOP")
            except Exception:
                pass

        if thread_exception[0] is not None:
            raise thread_exception[0]

        if not options.quiet:
            print(flush=True)  # newline after the progress bar

    ftp.quit()

    if os.stat(outfile).st_size == 0:
        os.unlink(outfile)
        raise IOError("Received zero-sized file")


# ---------------------------------------------------------------------------
# NCBI download
# ---------------------------------------------------------------------------

def download_sample_ncbi(sample, options):
    if not options.quiet:
        print(f"[NCBI] Downloading {sample['accession']} into {sample['file_base']}", flush=True)

    command_options = [
        options.fqdump,
        "--split-files",
        "--include-technical",
        "--threads", options.threads,
        "--temp", options.outdir,
        "--outfile", sample["file_base"] + ".fastq",
    ]

    if not options.quiet and sys.stdin.isatty():
        command_options.append("--progress")

    if options.outdir != ".":
        command_options.extend(["--outdir", options.outdir])

    command_options.append(sample["accession"])
    command_options = [str(x) for x in command_options]

    for attempt_number in range(1, options.retries + 1):
        if not options.quiet:
            print(
                f"[NCBI Attempt {attempt_number}] Running: " + " ".join(command_options),
                flush=True,
            )

        if attempt_number > 1:
            sleep_time = min(attempt_number ** 2, 30)
            print(f"Sleeping {sleep_time}s before retrying …")
            time.sleep(sleep_time)

        result = subprocess.run(command_options, check=False)

        if result.returncode != 0:
            if attempt_number == options.retries:
                raise IOError(
                    f"[NCBI] SRAtoolkit failed repeatedly, giving up on {sample['accession']}"
                )
            print("[NCBI] SRAtoolkit failed — going around for another try", flush=True)
        else:
            break

    # Compress the downloaded FASTQ files
    downloaded_files = glob.glob(
        os.path.join(options.outdir, sample["file_base"] + "*.fastq")
    )

    if not downloaded_files:
        raise IOError(f"[NCBI] Got no files for accession {sample['accession']}")

    for f in downloaded_files:
        if not options.quiet:
            print(f"Compressing {f}", flush=True)
        subprocess.run(["gzip", "-4", f], check=True)


# ---------------------------------------------------------------------------
# GEO name lookup
# ---------------------------------------------------------------------------

def get_geo_name(srr_number, options):
    """Fetch a human-readable sample name from GEO/NCBI.

    Retries up to options.retries times with exponential backoff.
    Returns an empty string if all attempts fail rather than raising.
    """
    if not options.quiet:
        print(f"Trying to get name for {srr_number} from GEO", flush=True)

    url = f"https://www.ncbi.nlm.nih.gov/sra/?term={srr_number}&format=text"

    for attempt in range(1, options.retries + 1):
        try:
            with urllib.request.urlopen(url, timeout=15) as response:
                for line in response:
                    line = line.decode("UTF-8")
                    if line.startswith("Title:"):
                        line = line.strip()
                        geo_sections = re.split(r"[:; ,/]+", line)
                        return "_".join(geo_sections[1:])
            # Response received but no Title line found — no point retrying
            break
        except Exception as ex:
            if attempt == options.retries:
                print(
                    f"WARNING: Could not fetch GEO name for {srr_number} "
                    f"after {options.retries} attempts: {ex}",
                    file=sys.stderr, flush=True,
                )
            else:
                sleep_time = min(attempt ** 2, 30)
                print(
                    f"WARNING: GEO lookup attempt {attempt} failed for {srr_number}: {ex} "
                    f"— retrying in {sleep_time}s",
                    file=sys.stderr, flush=True,
                )
                time.sleep(sleep_time)

    return ""


# ---------------------------------------------------------------------------
# Sample resolution + iteration
# ---------------------------------------------------------------------------

def _build_sample(accession, sections, name_index, options):
    """Resolve GEO name and return a sample dict for one accession.

    If any output file matching <accession>*.fastq.gz already exists and
    --force is not set, the GEO lookup is skipped entirely and the existing
    file's base name is reused — avoiding a network round-trip for files
    that will simply be skipped.
    """
    sample_name = ""

    # Check for existing files before doing the (potentially slow) GEO lookup
    if not options.force:
        existing = glob.glob(os.path.join(options.outdir, accession + "*.fastq.gz"))
        if existing:
            # Derive file_base from the first match (strip _1/_2.fastq.gz suffix)
            base = os.path.basename(existing[0])
            file_base = re.sub(r"(_[12])?\.fastq\.gz$", "", base)
            if not options.quiet:
                print(
                    f"Skipping GEO lookup for {accession} — "
                    f"existing file(s) found: {', '.join(os.path.basename(f) for f in existing)}",
                    flush=True,
                )
            return {"accession": accession, "file_base": file_base}

    if not options.nogeo:
        sample_name = get_geo_name(accession, options)

    if sample_name == "" and name_index >= 0 and sections is not None:
        sample_name = sections[name_index].strip()

    for bad_char in invalid_characters:
        sample_name = sample_name.replace(bad_char, "_")

    sample_name = "_" + sample_name  # leading underscore separator

    while "__" in sample_name:
        sample_name = sample_name.replace("__", "_")

    if not options.quiet:
        print(f"Found sample {accession} with basename {accession}{sample_name}", flush=True)

    return {"accession": accession, "file_base": accession + sample_name}


def iter_samples(options):
    """Generator that yields one fully-resolved sample dict at a time.

    Name resolution (including optional GEO lookup) happens immediately
    before each yield, so downloading can start without waiting for the
    entire list to be processed.
    """
    if not options.quiet:
        print(f"Reading samples from {options.runtable}", flush=True)

    sample_file = options.runtable

    try:
        with open(sample_file) as fh:
            csv_fh   = csv.reader(fh)
            headers  = []
            name_index = -1

            for sections in csv_fh:
                if not sections:
                    continue

                sections[0] = sections[0].strip()

                # Header row detection
                if not headers and sections[0] == "Run":
                    headers = sections
                    if "source_name" in headers:
                        name_index = headers.index("source_name")
                    continue

                # Skip repeated header rows mid-file
                if sections[0] == "Run":
                    continue

                # Yield immediately after resolving this single sample
                yield _build_sample(sections[0], sections, name_index, options)

    except FileNotFoundError:
        # Might be a bare accession rather than a filename
        if sample_file.startswith(("SRR", "ERR")):
            yield _build_sample(sample_file, None, -1, options)
        else:
            raise


# ---------------------------------------------------------------------------
# Options parsing
# ---------------------------------------------------------------------------

def read_options():
    parser = argparse.ArgumentParser(description="Download data from the SRA")

    parser.add_argument("--quiet", dest="quiet", action="store_true", default=False,
                        help="Suppress all but essential messages")
    parser.add_argument("--version", action="version", version=f"SRA downloader v{VERSION}")
    parser.add_argument("--outdir", type=str,
                        help="Folder to save data to (default: current directory)", default=".")
    parser.add_argument("--threads", type=int,
                        help="Number of threads for fasterq-dump (default 1)", default=1)
    parser.add_argument("--retries", type=int,
                        help="Retry attempts before giving up (default 5)", default=5)
    parser.add_argument("--force", dest="force", action="store_true", default=False,
                        help="Overwrite existing output files")
    parser.add_argument("--fqdump", type=str,
                        help="Path to fasterq-dump (default: fasterq-dump)", default="fasterq-dump")
    parser.add_argument("--nogeo", dest="nogeo", action="store_true",
                        help="Disable sample name lookup from GEO")
    parser.add_argument("--noena", dest="noena", action="store_true",
                        help="Don't try downloading from ENA")
    parser.add_argument("--noncbi", dest="noncbi", action="store_true",
                        help="Don't try downloading from NCBI")
    parser.add_argument("--axel-threads", dest="axel_threads", type=int, default=16,
                        help="Number of axel connections for ENA downloads (default 16)")
    parser.add_argument("runtable", type=str,
                        help="SraRunTable.txt file, accession list, or a bare SRR/ERR accession")

    options = parser.parse_args()

    # Detect axel
    try:
        subprocess.run(["axel", "--version"], check=True,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        options.axel = True
        if not options.quiet:
            print("Found axel — will use it for ENA downloads", flush=True)
    except Exception:
        options.axel = False
        if not options.quiet:
            print("axel not found — using built-in FTP downloader with progress bar", flush=True)

    if not options.noncbi:
        if not options.quiet:
            print("Testing for fasterq-dump at " + options.fqdump, flush=True)

        try:
            subprocess.run([options.fqdump, "--version"], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if not options.quiet:
                print("Found fasterq-dump at " + options.fqdump, flush=True)
        except Exception:
            print(
                f"WARNING: Couldn't find fasterq-dump at {options.fqdump}. "
                "Ensure sratoolkit is installed and vdb-config has been run "
                "if you want to download from NCBI.",
                file=sys.stderr, flush=True,
            )
            options.noncbi = True

        if not options.quiet:
            print("Testing for gzip", flush=True)

        try:
            subprocess.run(["gzip", "--version"], check=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if not options.quiet:
                print("Found gzip", flush=True)
        except Exception:
            print(
                "WARNING: Couldn't find gzip — can't download from NCBI without it.",
                file=sys.stderr, flush=True,
            )
            options.noncbi = True

    if options.noncbi and options.noena:
        print("ERROR: Both NCBI and ENA download options are unavailable. Giving up.",
              file=sys.stderr, flush=True)
        sys.exit(1)

    if not os.path.isdir(options.outdir):
        os.makedirs(options.outdir)

    return options


# ---------------------------------------------------------------------------
# Results log
# ---------------------------------------------------------------------------

def _write_results_log(results, outdir):
    log_path = os.path.join(outdir, "sradownloader_results.txt")
    try:
        with open(log_path, "w") as fh:
            fh.write("ACCESSION\tRESULT\n")
            for accession in sorted(results.keys()):
                fh.write(f"{accession}\t{results[accession]}\n")
        print(f"\nResults log written to: {log_path}", flush=True)
    except Exception as ex:
        print(f"WARNING: Could not write results log: {ex}", file=sys.stderr, flush=True)


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    options = read_options()
    results = {}

    try:
        for sample in iter_samples(options):
            try:
                if options.noena:
                    raise Exception("ENA disabled with --noena.")
                download_sample_ena(sample, options)
                results[sample["accession"]] = "SUCCEEDED"

            except Exception as ex:
                if options.noncbi:
                    print(
                        f"WARNING: Failed via ENA: {ex}. Can't try NCBI — giving up.",
                        file=sys.stderr, flush=True,
                    )
                    results[sample["accession"]] = "FAILED"
                else:
                    print(
                        f"WARNING: Failed via ENA: {ex} — trying NCBI instead",
                        file=sys.stderr, flush=True,
                    )
                    try:
                        download_sample_ncbi(sample, options)
                        results[sample["accession"]] = "SUCCEEDED"
                    except Exception as ex2:
                        print(
                            f"WARNING: Failed via NCBI: {ex2}. Giving up — sorry.",
                            file=sys.stderr, flush=True,
                        )
                        results[sample["accession"]] = "FAILED"

    except KeyboardInterrupt:
        print("\n\nInterrupted by user.", file=sys.stderr, flush=True)

    finally:
        if results:
            if not options.quiet:
                print("\nAll done!\n\nRESULTS\n-------", flush=True)
                for accession in sorted(results.keys()):
                    print(f"{accession}:\t{results[accession]}", flush=True)
            _write_results_log(results, options.outdir)


if __name__ == "__main__":
    main()
